# ==============================================================================
# Forma Mobile Environment Configuration
# Load into Flutter using: flutter run --dart-define-from-file=.env
# ==============================================================================

# Backend API Base URL
# - For iOS Simulator / macOS / Web / Windows: http://localhost:3000
# - For Android Emulator (10.0.2.2 maps to host machine localhost): http://10.0.2.2:3000
# - For Physical Device (same Wi-Fi network): http://<YOUR_LOCAL_IP>:3000
API_BASE_URL=http://localhost:3000

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Network Timeouts (milliseconds)
API_TIMEOUT_MS=15000

# Feature Flags & Debugging
ENABLE_ANALYTICS_LOGS=false
