# ==============================================================================
# Forma Backend Environment Configuration
# ==============================================================================
# This file lists REQUIRED variable NAMES only. Never commit real secret values.

# Server Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Connection (Application Role) — REQUIRED
DATABASE_URL=
DATABASE_URL_TEST=

# Database Connection for Migrations (Superuser / Schema Owner) — REQUIRED for npm run migrate
DATABASE_URL_MIGRATIONS=

# Password used by migration 003 to provision the forma_app role — REQUIRED for first-time setup
FORMA_APP_DB_PASSWORD=

# JWT Authentication Secrets — REQUIRED (min 32 chars, use a CSPRNG e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# BYOK Master Encryption Key — REQUIRED (64 hex chars = 32 bytes, e.g. `openssl rand -hex 32`)
ENCRYPTION_MASTER_KEY=

# Cross-Origin Resource Sharing allowlist (comma-separated origins).
# Required in production for browser clients; localhost is always allowed outside production.
# CORS_ORIGINS=https://app.forma.example,https://www.forma.example

# AI provider keys (optional; users supply keys via Settings → BYOK)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
SECONDARY_AI_BASE_URL=
SECONDARY_AI_API_KEY=

# Local Network Server Configuration
# Set LOCAL_SERVER=true to bind to 0.0.0.0 and allow mobile devices on the same Wi-Fi to communicate
LOCAL_SERVER=false
# Optional explicit host override (e.g. 127.0.0.1 or 0.0.0.0)
# HOST=0.0.0.0
