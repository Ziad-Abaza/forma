# ==============================================================================
# Forma Backend Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Connection (Application Role)
DATABASE_URL=postgresql://forma_app:forma_secure_app_role_pw@localhost:5432/forma_dev
DATABASE_URL_TEST=postgresql://forma_app:forma_secure_app_role_pw@localhost:5432/forma_test

# Database Connection for Migrations (Superuser / Schema Owner)
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgrespassword@localhost:5432/forma_dev

# JWT Authentication Secrets (Minimum 32 characters for production security)
JWT_ACCESS_SECRET=forma_dev_access_token_secret_minimum_32_characters!
JWT_REFRESH_SECRET=forma_dev_refresh_token_secret_minimum_32_characters!

# Google Gemini AI Integration
GEMINI_API_KEY=
AI_PRIMARY_MODEL=gemini-3.8-flash

# Local Network Server Configuration
# Set LOCAL_SERVER=true to bind to 0.0.0.0 and allow mobile devices on the same Wi-Fi to communicate
LOCAL_SERVER=false
# Optional explicit host override (e.g. 127.0.0.1 or 0.0.0.0)
# HOST=0.0.0.0
